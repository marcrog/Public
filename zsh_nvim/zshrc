# ==========================================
# 1. INIZIALIZZAZIONE OH MY ZSH
# ==========================================

# Percorso di installazione
export ZSH="$HOME/.oh-my-zsh"

# Scegli il tuo tema (robbyrussell è quello di default)
ZSH_THEME="robbyrussell"

# Plugin attivi
plugins=(git)

# Carica il framework
source $ZSH/oh-my-zsh.sh


# ==========================================
# 3. SUGGERIMENTI AUTOMATICI (AUTOSUGGESTIONS)
# ==========================================
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# ==========================================
# 3. SUGGERIMENTI E CAMBIO PROFILO AUTOMATICO
# ==========================================
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# Controlla se macOS è in Dark Mode
if [[ $(defaults read -g AppleInterfaceStyle 2>/dev/null) == "Dark" ]]; then
    
    # --- TEMA SCURO ---
    # 1. Cambia il profilo del Terminale (Sostituisci "Pro" con il tuo profilo scuro)
    osascript -e 'tell application "Terminal" to set current settings of selected tab of front window to settings set "ayu"' 2>/dev/null
    
    # 2. Colore dei suggerimenti Zsh
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=198"

else

    # --- TEMA CHIARO ---
    # 1. Cambia il profilo del Terminale (Sostituisci "Basic" con il tuo profilo chiaro)
    osascript -e 'tell application "Terminal" to set current settings of selected tab of front window to settings set "ayu Light"' 2>/dev/null
    
    # 2. Colore dei suggerimenti Zsh
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=magenta"

fi



